  45          *******************************************************************************/
  46          void DigDisplay()
  47          {
  48   1        unsigned char i;
  49   1        unsigned int j;
  50   1        for(i=0;i<8;i++)
  51   1        {
  52   2          switch(i)  //位选，选择点亮的数码管，
  53   2          {
  54   3            case(0):
  55   3              LSA=0;LSB=0;LSC=0; break;//显示第0位
C51 COMPILER V9.01   MAIN                                                                  08/16/2013 16:34:20 PAGE 2   

  56   3            case(1):
